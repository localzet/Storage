{
  "name": "localzet/storage",
  "description": "A client/server shared in-memory data store for Localzet Server applications.",
  "type": "library",
  "keywords": [
    "storage",
    "global",
    "PHP",
    "library",
    "localzet",
    "AGPL",
    "data"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "issues": "https://github.com/localzet/Storage/issues",
    "source": "https://github.com/localzet/Storage"
  },
  "require": {
    "php": "^8.2",
    "localzet/server": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "localzet\\Storage\\": "src/"
    }
  },
  "scripts": {
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "php tests/security_regression.php",
    "test:integration": "php tests/integration.php",
    "check": [
      "@lint",
      "@test",
      "@test:integration"
    ]
  }
}
